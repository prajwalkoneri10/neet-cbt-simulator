# ========================================================
# NEET CBT Simulator — Server Environment Configuration
# ========================================================

# Port for the Node.js Express server (Render sets PORT automatically)
PORT=5000

# Strong secret key for signing JWT tokens (min 32 characters in production)
JWT_SECRET=replace_with_a_very_strong_random_secret_at_least_32_characters_long

# PostgreSQL Connection String (Render PostgreSQL or compatible database)
# Example: postgresql://username:password@dpg-xxxxx-a.oregon-postgres.render.com/neet_cbt_db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/neet_cbt

# Allowed Frontend Origins (comma-separated list for CORS allowlist)
# Example: https://neet-cbt-simulator.vercel.app,http://localhost:5173
CLIENT_URLS=https://neet-cbt-simulator.vercel.app,http://localhost:5173

# Single fallback frontend origin (for backward compatibility)
CLIENT_URL=http://localhost:5173

# Allow Vercel preview deployment URLs (e.g., https://neet-cbt-simulator-*-username.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# Node Environment: 'development' or 'production'
NODE_ENV=development

# Optional: Resend API Key for password reset emails
# If omitted, password reset links are printed to the server log in development
RESEND_API_KEY=re_sample_api_key_optional
RESET_EMAIL_FROM=onboarding@resend.dev
