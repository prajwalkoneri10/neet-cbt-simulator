# ========================================================
# NEET CBT Simulator — Frontend Environment Configuration
# ========================================================

# Base URL of the backend API (with or without /api suffix)
# Local Development:
VITE_API_URL=http://localhost:5000/api

# Production (Vercel):
# Set this in your Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://your-backend-app.onrender.com/api
#
# IMPORTANT: Vite environment variables are embedded at build time!
# Any change to VITE_API_URL requires redeploying/rebuilding the frontend.
